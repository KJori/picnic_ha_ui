{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@/*": ["./vendor/picnic-web/src/*"],
      "next/server": ["./src/server/next-server.ts"]
    }
  },
  "include": ["src", "vendor/picnic-web/src", "tests", "scripts/*.ts"],
  // picnic-web's meal plan file format reads a type from its React hooks
  // (src/hooks), which are not copied; the desk does not use the file.
  "exclude": ["vendor/picnic-web/src/lib/meal-plan/meal-plan-file.ts"]
}
